# Server Settings
PORT=8080

# Database Configuration (MongoDB Atlas URI)
# Local Fallback: mongodb://localhost:27017/academic_pathway
# Atlas Example: mongodb+srv://smartspendadmin:<db_password>@cluster0.g3tkccm.mongodb.net/academic_pathway?appName=Cluster0
SPRING_DATA_MONGODB_URI=mongodb://localhost:27017/academic_pathway

# Grok (xAI) API Configuration
# If provided, Grok API is used to generate recommendation reasoning.
# If left blank, local template heuristics are used as fallback automatically.
GROK_API_KEY=
GROK_MODEL=grok-2

# Spring SMTP Email Settings (Optional)
# If provided, recommendation summaries are emailed to students automatically.
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
